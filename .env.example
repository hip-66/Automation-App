# PS Automation - environment template.
# Copy this file to ".env" and fill in real values. ".env" itself is
# git-ignored and must NEVER be committed - it holds the real secrets.
#
# To generate fresh values for a new .env, run:  python generate_env.py

# Flask session signing key (any long random string)
FLASK_SECRET_KEY=

# Admin login (username: Admin). Password is a salted PBKDF2 hash, not the
# plain password - generate it with generate_env.py.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=120

# Network binding - defaults to 127.0.0.1 (this machine only), since each
# machine runs its own local clone. Only set PS_AUTOMATION_HOST if THIS
# specific machine should also be reachable from other machines on the LAN.
# PS_AUTOMATION_HOST=127.0.0.1
# PS_AUTOMATION_PORT=4444

# Symmetric key (Fernet/AES) used to encrypt the default credentials below.
ENCRYPTION_KEY=

# Default iDRAC / ESXi login (racadm, pyVmomi) - encrypted values.
DEFAULT_CRED_USERNAME_ENC=
DEFAULT_CRED_PASSWORD_ENC=

# Default SSH login (MDE validation / DNS-NTP scripts) - encrypted values.
DEFAULT_SSH_USERNAME_ENC=
DEFAULT_SSH_PASSWORD_ENC=
