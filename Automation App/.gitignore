# Secrets - never commit
.env

# Generated at runtime
Outputs/
Logs/
history.json
app_errors.log

# Per-script working files written by the app at run time
Scripts/**/addresses.txt
Scripts/**/hostnames.txt
Scripts/**/dns.txt
Scripts/**/ntp.txt
Scripts/**/commands.txt

# Backups made during development
Backup/
_backups/

# Startup fast-path marker (created after the dependency check passes once)
.deps_ok

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local scratch/test area
Only Test/

# Large offline installers (e.g. python-3.x.x-amd64.exe) - don't bloat git
*.exe
!PS-Automation.exe
